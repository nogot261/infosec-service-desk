digraph "Компоненты" {graph [rankdir=TB,fontname="DejaVu Sans",fontsize=12,label="Диаграмма компонентов информационной системы",labelloc=t,bgcolor=white,nodesep=.7,ranksep=.8];node[shape=box,color=black,style=rounded,fontname="DejaVu Sans",fontsize=10];edge[fontname="DejaVu Sans",fontsize=9,color=black];b[label="Браузер\nHTML, CSS"]; web[label="Веб-сервер\nFlask, web.py"];svc[label="Предметные функции\nservice.py"]; db[label="База данных\nSQLite, db.py"];sec[label="Проверка доступа\nsecurity.py"]; ex[label="Файловый обмен\nexchange.py, openpyxl"];b->web[label="HTTP"];web->svc;web->sec;svc->db;web->ex;ex->db; }