digraph "База" {graph [rankdir=LR,fontname="DejaVu Sans",fontsize=12,label="Схема базы данных: 11 таблиц",labelloc=t,bgcolor=white,nodesep=.5,ranksep=1.0]; node[shape=record,color=black,fontname="DejaVu Sans",fontsize=9];edge[arrowsize=.7,color=black]; users[label="{users|id PK\nusername\nrole}"];assets[label="{assets|id PK\ninventory_no}"];tickets[label="{tickets|id PK\nauthor_id FK\nassignee_id FK\nasset_id FK\nstatus}"];comments[label="{comments|id PK\nticket_id FK\nauthor_id FK}"];audit[label="{audit_events|id PK\nticket_id FK\nactor_id FK}"];services[label="{service_catalog|id PK\ncode}"];feedback[label="{feedback_messages|id PK\nstate}"];attach[label="{ticket_attachments|id PK\nticket_id FK}"];history[label="{ticket_status_history|id PK\nticket_id FK}"];notif[label="{notifications|id PK\nuser_id FK}"]; settings[label="{application_settings|setting_key PK}"]; users->tickets [label="создаёт/исполняет"];assets->tickets[label="объект обращения"];tickets->comments;tickets->audit;tickets->attach;tickets->history;users->notif;services->tickets[style=dotted,label="категория услуг"];settings->services[style=invis];feedback->services[style=invis];}